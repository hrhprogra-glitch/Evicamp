{"nodes": [{"id": "claude_skills_graphify_skill", "label": "graphify Skill (SKILL.md)", "file_type": "document", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_graphify_tool", "label": "graphify (knowledge graph CLI/skill)", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_ast_extraction", "label": "AST structural extraction (Part A)", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_semantic_extraction", "label": "Semantic extraction (Part B, LLM subagents)", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_extraction_cache", "label": "Semantic extraction cache keyed by prompt file", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cache entries are attributed to extraction-spec.md (the exact extraction prompt) so that when a graphify upgrade changes the prompt, entries produced by the old prompt are re-extracted instead of replayed, while unchanged prompts keep their cached entries (#1939)."}, {"id": "concept_shrink_guard_479", "label": "graph.json shrink guard (#479)", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "to_json refuses to write graph.json when the new graph has fewer nodes than the existing one, so an empty or partial extraction can never silently clobber a good graph.json/GRAPH_REPORT.md/analysis sidecar (#479)."}, {"id": "concept_manifest_stamping", "label": "Manifest stamping - only stamp successful semantic extractions (#2015)", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only stamp semantic files (docs/papers/images) that actually produced output this run; a detected file whose chunk failed or was omitted must stay unstamped so the next --update re-queues it, otherwise it is marked done and its content is lost forever (#2015)."}, {"id": "concept_honesty_rules", "label": "graphify Honesty Rules", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never invent an edge (use AMBIGUOUS when unsure); never skip the corpus-size warning; always show token cost; never hide cohesion scores behind symbols; never run HTML viz on a graph over 5,000 nodes without warning the user."}, {"id": "concept_no_api_key_needed", "label": "graphify needs no API key (code-only skip)", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "graphify needs no API key and must never block on one: code is extracted structurally via AST with no LLM at all, so a code-only corpus skips semantic extraction entirely; semantic extraction (docs/papers/images only) uses Gemini only if GEMINI_API_KEY/GOOGLE_API_KEY is already set, otherwise the host agent itself acts as the LLM - graphify never reads ANTHROPIC_API_KEY or OPENAI_API_KEY."}], "edges": [{"source": "claude_skills_graphify_skill", "target": "claude_skills_graphify_references_add_watch", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_graphify_skill", "target": "claude_skills_graphify_references_exports", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_graphify_skill", "target": "claude_skills_graphify_references_extraction_spec", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_graphify_skill", "target": "claude_skills_graphify_references_github_and_merge", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_graphify_skill", "target": "claude_skills_graphify_references_hooks", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_graphify_skill", "target": "claude_skills_graphify_references_query", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_graphify_skill", "target": "claude_skills_graphify_references_transcribe", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_graphify_skill", "target": "claude_skills_graphify_references_update", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location"