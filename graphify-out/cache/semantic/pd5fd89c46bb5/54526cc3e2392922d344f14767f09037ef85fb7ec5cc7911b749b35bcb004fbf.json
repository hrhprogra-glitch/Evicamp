{"nodes": [{"id": "claude_skills_graphify_references_query", "label": "graphify reference: query.md", "file_type": "document", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_vocab_expansion", "label": "Constrained query vocabulary expansion", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "graphify's query matcher is case-folded substring + IDF with no stemming, no synonyms, and no cross-language matching; if the user's question uses different vocabulary than the graph's node labels the literal matcher returns zero hits and the answer collapses to noise, so the query must first be expanded to tokens verified present in the graph's own vocabulary - never invented tokens."}, {"id": "concept_work_memory_loop", "label": "Self-improving work memory (save-result --outcome, reflect)", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Query/path/explain answers are saved back into the graph with an --outcome (useful/dead_end/corrected) so the next --update extracts them as graph nodes, closing a feedback loop where future sessions prefer proven-useful sources and skip known dead ends."}, {"id": "concept_lessons_md", "label": "LESSONS.md (reflections)", "file_type": "concept", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "claude_skills_graphify_references_query", "target": "claude_skills_graphify_skill", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": 